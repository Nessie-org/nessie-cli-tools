{
  "name": "@nessie/cli",
  "version": "0.1.0",
  "description": "Nessie project management CLI",
  "type": "module",
  "bin": {
    "nessie": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/config && cp src/config/nessie.config.json dist/config/nessie.config.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "ora": "^8.0.1",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src/config"
  ]
}
